# Copy to .env and fill in. Never commit .env.
# Values marked "(Phase N)" are read by features that land in that phase.

# --- Telegram (required to run the bot) --------------------------------------------------------
# From @BotFather. Disable privacy mode (/setprivacy -> Disable) BEFORE adding the bot to a group.
ELYSIUM_TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs with full control (owners).
ELYSIUM_OWNER_USER_IDS=

# --- Storage -------------------------------------------------------------------------------------
# SQLite (default) or PostgreSQL: postgresql+asyncpg://elysium:<password>@db:5432/elysium
ELYSIUM_DATABASE_URL=sqlite+aiosqlite:////data/elysium.db
ELYSIUM_DATA_DIR=/data
# Only needed with `docker compose --profile postgres`.
POSTGRES_PASSWORD=

# --- Behaviour -----------------------------------------------------------------------------------
ELYSIUM_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
ELYSIUM_LOG_LEVEL=INFO
# json | console
ELYSIUM_LOG_FORMAT=json

# --- Health --------------------------------------------------------------------------------------
ELYSIUM_HEARTBEAT_INTERVAL_S=30
ELYSIUM_HEARTBEAT_MAX_AGE_S=120

# --- Claude / Anthropic API (Phase 5) ------------------------------------------------------------
ANTHROPIC_API_KEY=
ELYSIUM_AI_ROUTINE_MODEL=claude-sonnet-5-5
ELYSIUM_AI_ROUTINE_EFFORT=medium
ELYSIUM_AI_DEEP_MODEL=claude-opus-5-5
ELYSIUM_AI_DEEP_EFFORT=high
ELYSIUM_AI_DAILY_BUDGET_USD=5.0
ELYSIUM_AI_DAILY_BUDGET_CAP_USD=20.0
ELYSIUM_AI_MAX_MESSAGES_PER_RUN=20000
ELYSIUM_AI_FALLBACKS_ENABLED=true
# Never enable in production: logs prompt/response bodies at DEBUG.
ELYSIUM_LOG_AI_PAYLOADS=false
# JSON overriding default model prices (USD per MTok), e.g. {"claude-sonnet-5-5": {"input": 2, "output": 10}}
ELYSIUM_PRICING_OVERRIDES_JSON=
# Optional Anthropic web search for external verification (Phase 8).
ELYSIUM_WEB_VERIFICATION=false

# --- Data lifecycle & exports (Phase 4 / 9) ------------------------------------------------------
# Empty = keep forever.
ELYSIUM_RETENTION_DAYS=
ELYSIUM_EXPORT_MAX_PER_HOUR=5

# --- Optional MTProto history backfill (Phase 2c; off by default) -------------------------------
ELYSIUM_MTPROTO_ENABLED=false
# From https://my.telegram.org (use your own app credentials).
ELYSIUM_TELEGRAM_API_ID=
ELYSIUM_TELEGRAM_API_HASH=
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ELYSIUM_MTPROTO_SESSION_KEY=

# --- On-chain providers (Phase 7) ----------------------------------------------------------------
# JSON mapping chains to provider endpoints; Elysium mainnet endpoints are not yet published.
ELYSIUM_ONCHAIN_PROVIDERS_JSON=
